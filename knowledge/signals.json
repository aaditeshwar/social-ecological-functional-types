{
 "_about": "Signal library. A signal turns one indicator (variables.json) or one condition into a yes/no answer and a grade between 0 and 1. kind: system (does a production system hold enough of the MWS; uses share_<archetype>), context (amplifier or setting: aquifer, terrain, rivers, institutions), stress (evidence of the stress itself). A numeric signal compares its var with the first threshold whose 'when' holds (or, when use_absolute is false or nothing matches, with pooled percentiles over the run). Grade: 0 before the threshold, 0.5 at the threshold, rising linearly to 1 at the severe threshold. The signal is 'on' when its grade is at least 0.5. A boolean signal (expr) has grade 0 or 1. Rules in causal_graph.json refer to signals by id; the same signal can play different roles in different rules.",
 "version": "0.1",
 "grading": {
  "at_threshold": 0.5,
  "at_severe": 1.0,
  "rule": "grade = 0 if the threshold is not crossed; otherwise 0.5 + 0.5 × ramp(value, threshold, severe threshold)"
 },
 "signals": [
  {
   "id": "sys_gw_users",
   "kind": "system",
   "label": "Groundwater-using systems hold ≥ 10%",
   "expr": "share_groundwater_irrigated + share_tree_crops + 0.5 * share_canal_irrigated >= 0.10",
   "note": "Canal land counts half because canal commands also pump groundwater."
  },
  {
   "id": "sys_gw_irrigated",
   "kind": "system",
   "label": "Groundwater-irrigated farming holds ≥ 10%",
   "expr": "share_groundwater_irrigated >= 0.10"
  },
  {
   "id": "sys_irrigated",
   "kind": "system",
   "label": "Irrigated farming or orchards hold ≥ 10%",
   "expr": "share_groundwater_irrigated + share_canal_irrigated + share_tree_crops >= 0.10"
  },
  {
   "id": "sys_rainfed_or_tank",
   "kind": "system",
   "label": "Rainfed or tank-fed farming holds ≥ 15%",
   "expr": "share_rainfed_dryland + share_rainfed_rice_subhumid + share_tank_irrigated >= 0.15"
  },
  {
   "id": "sys_rainfed",
   "kind": "system",
   "label": "Rainfed farming holds ≥ 15%",
   "expr": "share_rainfed_dryland + share_rainfed_rice_subhumid >= 0.15"
  },
  {
   "id": "sys_rice_rainfed",
   "kind": "system",
   "label": "Rainfed sub-humid (rice-based) farming holds ≥ 15%",
   "expr": "share_rainfed_rice_subhumid >= 0.15"
  },
  {
   "id": "sys_surface_irrigated",
   "kind": "system",
   "label": "Tank- or canal-irrigated farming holds ≥ 10%",
   "expr": "share_tank_irrigated + share_canal_irrigated >= 0.10"
  },
  {
   "id": "sys_canal",
   "kind": "system",
   "label": "Canal-irrigated farming holds ≥ 10%",
   "expr": "share_canal_irrigated >= 0.10"
  },
  {
   "id": "sys_cropland",
   "kind": "system",
   "label": "Farming systems hold ≥ 10%",
   "expr": "share_rainfed_dryland + share_rainfed_rice_subhumid + share_groundwater_irrigated + share_canal_irrigated + share_tank_irrigated >= 0.10",
   "note": "Checks the cropland total (all cropland archetypes summed), not whether any one archetype is present. Archetype presence (15%, tank 10%) says which archetypes describe the MWS; this gate says whether there is enough cropland for a cropland stress to matter. Cropland is often split across archetypes, so a per-archetype gate would skip MWS with 15–20% cropland in total (decision of 22 Nov 2026)."
  },
  {
   "id": "sys_cropland_20",
   "kind": "system",
   "label": "Farming systems hold ≥ 20%",
   "expr": "share_rainfed_dryland + share_rainfed_rice_subhumid + share_groundwater_irrigated + share_canal_irrigated + share_tank_irrigated >= 0.20"
  },
  {
   "id": "sys_peri_urban",
   "kind": "system",
   "label": "Peri-urban settlement holds ≥ 3%",
   "expr": "share_peri_urban >= 0.03"
  },
  {
   "id": "sys_trees",
   "kind": "system",
   "label": "Forest or tree crops hold ≥ 15%",
   "expr": "share_forest_fringe + share_tree_crops >= 0.15"
  },
  {
   "id": "sys_forest",
   "kind": "system",
   "label": "Forest-fringe system holds ≥ 10%",
   "expr": "share_forest_fringe >= 0.10"
  },
  {
