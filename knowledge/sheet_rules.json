{
 "_about": "Write knowledge/sheet_rules.json: the Signal_Verification sheet's revised signals, triggers and intensities\n(Signal_Verification_1.xlsx, 21 Nov 2026) as expressions over the cached CoRE Stack data.\n\nReading conventions (agreed 21 Nov 2026):\n- each signal is 1 when true, 0 when false; in triggers and intensities `or` is a sum and `and` a product;\n  `(sig_03 or sig_04 or sig_05 > 1)` is sig_03 + sig_04 + sig_05 > 1;\n- `shrub_slope` is read as the NDVI `shrub_trend` class;\n- nitrogen percentiles of exactly 0 are missing data (CS-91), not zero nitrogen.\nRun from the repo root: python tools/build_sheet_rules.py",
 "source": "Signal_Verification_1.xlsx (Revised Patterns), 21 Nov 2026",
 "rules": [
  {
   "id": "groundwater_stress",
   "section": "Agriculture / Water",
   "signals": {
    "sig_01": {
     "expr": "mean(hydro.precipitation) < 800 and ((soge.class_name != 'Safe') if is_text(soge.class_name) else nan)",
     "sheet": "Average(Precipitation_in_mm_)<800 and soge_class_name not in ['Safe']"
    },
    "sig_02": {
     "expr": "mean(hydro.delta_g) < -70",
     "sheet": "mean(DeltaG_in_mm_) < -70mm"
    },
    "sig_03": {
     "expr": "conn.n_upstream == 0",
     "sheet": "len(upstream_mws) == 0"
    },
    "sig_04": {
     "expr": "river.n == 0 and canal.n == 0",
     "sheet": "river is None and canal is None"
    },
    "sig_05": {
     "expr": "mean(ci.cropping_intensity) > 1.6",
     "sheet": "cropping_intensity_unit_less_ > 1.6"
    }
   },
   "trigger": "(sig_01 + sig_02) * (sig_03 + sig_04 + sig_05) > 0",
   "sheet_trigger": "(sig_01 or sig_02) and (sig_03 or sig_04 or sig_05)",
   "intensity": "(sig_01 + sig_02) * (sig_03 + sig_04 + sig_05)",
   "out_of": 6,
   "type": "stress"
  },
  {
   "id": "high_drought_risk",
   "section": "Agriculture / Water",
   "signals": {
    "sig_01": {
     "expr": "mean(drought.severe) + mean(drought.moderate) > 1 and max(drought.severe) + max(drought.moderate) > 6",
     "sheet": "((mean(Severe_in_weeks_) + mean(Moderate_in_weeks_)) > 1) and (max(Severe_in_weeks_) + max(Moderate_in_weeks_)) > 6"
    },
    "sig_02": {
     "expr": "max(drought.dry_spell) > 4 and mean(drought.dry_spell) > 2.5",
     "sheet": "max(drysp_unit_4_weeks_) > 4 and mean(drysp_unit_4_weeks_) > 2.5"
    },
    "sig_03": {
     "expr": "(mean(hydro.precipitation) < 600 or div(mean(hseas.precipitation_kharif), mean(hydro.precipitation)) < 0.66) and max(hydro.precipitation) < 1500",
     "sheet": "(mean(Precipitation_in_mm_)<600 or mean(precipitation_kharif_in_mm_) / mean(Precipitation_in_mm_) < 0.66) and max(Precipitation_in_mm_) < 1500"
    },
    "sig_04": {
     "expr": "div(mean(hydro.runoff), mean(hydro.precipitation)) > 0.2",
     "sheet": "mean(RunOff_in_mm) / mean(Precipitation_in_mm_) > 0.2"
    },
    "sig_05": {
     "expr": "min(hydro.precipitation) < 400",
     "sheet": "min(Precipitation_in_mm_) < 400"
    }
   },
   "trigger": "(sig_01 + sig_02 > 0) * (sig_03 + sig_04 + sig_05 > 1) > 0",
   "sheet_trigger": "(sig_01 or sig_02) and (sig_03 or sig_04 or sig_05 > 1)",
   "intensity": "(sig_01 + sig_02) * (sig_03 + sig_04 + sig_05)",
   "out_of": 6,
   "type": "stress"
  },
  {
   "id": "high_irrigation_difficulties",
   "section": "Agriculture / Water",
   "signals": {
    "sig_01": {
     "expr": "mean(div(swb.rabi_area, swb.kharif_area)) < 0.995",
     "sheet": "mean(rabi_area_in_ha_ / kharif_area_in_ha_) < 0.995"
    },
    "sig_02": {
     "expr": "last(swb.total_area) - first(swb.total_area) < 0 and nfalls(swb.total_area) >= 0.5 * nvalid(swb.total_area)",
     "sheet": "(total_area_in_ha_[-1] - total_area_in_ha_[0]) < 0 AND number of years with a year-on-year fall >= 0.5*(total number of years)"
    },
    "sig_03": {
     "expr": "(((soge.class_name == 'Semi-Critical' or soge.class_name == 'Semi Critical' or soge.class_name == 'Critical') if is_text(soge.class_name) else nan) or mean(hydro.delta_g) < -120) and conn.n_upstream <= 2",
     "sheet": "(soge_class_name in ['Semi-Critical', 'Critical'] or mean(DeltaG_in_mm_) < -120mm) and (len(upstream_mws)<=2)"
    },
    "sig_04": {
     "expr": "river.n == 0 and canal.n == 0 and div(mean(swb.rabi_area), area) < 0.4",
     "sheet": "canal is None AND river is None AND average(rabi_area_in_ha_ / mws area) < 0.4"
    },
    "sig_05": {
     "expr": "sum(nz(nrega.irrigation_on_farms)) < 15 and div(mean(ci.doubly_cropped_area), area) > 0.1",
     "sheet": "sum_nrega_annual['Irrigation on farms'] < 15 AND average(doubly_cropped_area_in_ha_ / mws area) > 0.1"
    }
   },
   "trigger": "sig_01 * (sig_02 + sig_03 + sig_04 + sig_05 >= 2) > 0",
   "sheet_trigger": "sig_01 and (sig_02 + sig_03 + sig_04 + sig_05 >= 2)",
   "intensity": "sig_01 * (sig_02 + sig_03 + sig_04 + sig_05)",
   "out_of": 4,
   "type": "stress"
  },
  {
   "id": "soil_health",
   "section": "Agriculture / Soil",
   "signals": {
    "sig_01": {
     "expr": "frac_below_nz(120, [soil.n_p05_in_kg_per_ha, soil.n_p10_in_kg_per_ha, soil.n_p20_in_kg_per_ha, soil.n_p30_in_kg_per_ha, soil.n_p40_in_kg_per_ha, soil.n_p50_in_kg_per_ha, soil.n_p60_in_kg_per_ha, soil.n_p70_in_kg_per_ha, soil.n_p80_in_kg_per_ha, soil.n_p90_in_kg_per_ha, soil.n_p95_in_kg_per_ha]) >= 0.95",
     "sheet": "nitrogen_area[<120] / area_under_cropping_in_ha >= 0.95"
    },
    "sig_02": {
     "expr": "frac_below(25, [soil.p_p05_in_kg_per_ha, soil.p_p10_in_kg_per_ha, soil.p_p20_in_kg_per_ha, soil.p_p30_in_kg_per_ha, soil.p_p40_in_kg_per_ha, soil.p_p50_in_kg_per_ha, soil.p_p60_in_kg_per_ha, soil.p_p70_in_kg_per_ha, soil.p_p80_in_kg_per_ha, soil.p_p90_in_kg_per_ha, soil.p_p95_in_kg_per_ha]) > 0.8",
     "sheet": "phosphorus_area[<25] / area_under_cropping_in_ha > 0.8"
    },
    "sig_03": {
     "expr": "frac_below(210, [soil.k_p05_in_kg_per_ha, soil.k_p10_in_kg_per_ha, soil.k_p20_in_kg_per_ha, soil.k_p30_in_kg_per_ha, soil.k_p40_in_kg_per_ha, soil.k_p50_in_kg_per_ha, soil.k_p60_in_kg_per_ha, soil.k_p70_in_kg_per_ha, soil.k_p80_in_kg_per_ha, soil.k_p90_in_kg_per_ha, soil.k_p95_in_kg_per_ha]) > 0.4",
     "sheet": "potassium_area[<210] / area_under_cropping_in_ha > 0.4"
    },
    "sig_04": {
     "expr": "frac_below(0.5, [soil.oc_p05_in_percent, soil.oc_p10_in_percent, soil.oc_p20_in_percent, soil.oc_p30_in_percent, soil.oc_p40_in_percent, soil.oc_p50_in_percent, soil.oc_p60_in_percent, soil.oc_p70_in_percent, soil.oc_p80_in_percent, soil.oc_p90_in_percent, soil.oc_p95_in_percent]) >= 0.4",
     "sheet": "organic_carbon_area[<0.5] / area_under_cropping_in_ha >= 0.4"
    }
   },
   "trigger": "sig_01 + sig_02 + sig_03 + sig_04 >= 2",
   "sheet_trigger": "sig_01 + sig_02 + sig_03 + sig_04 >= 2",
   "intensity": "sig_01 + sig_02 + sig_03 + sig_04",
   "out_of": 4,
   "type": "stress"
  },
  {
   "id": "decreasing_productivity",
   "section": "Agriculture / Yield",
   "signals": {
    "sig_01": {
     "expr": "div(degr.farm_to_scrub_land_area, ci.sum_area) > 0.08 and 0 < ci.sum_area < 500",
     "sheet": "farm_to_scrub_land_area_in_ha/sum_area_in_ha (cropping) > 8% AND 0 < sum_area_in_ha (cropping) < 500"
    },
    "sig_02": {
     "expr": "late(ci.cropping_intensity, 2) - early(ci.cropping_intensity, 2) < 0",
     "sheet": "mean(last two cropping_intensity values) - mean(first two cropping_intensity values) < 0"
    },
    "sig_03": {
     "expr": "mean(ci.triply_cropped_area) < 15 and mean(ci.single_kharif_cropped_area) < 140",
     "sheet": "Average(triply_cropped_area_in_ha_) < 15 AND Average(single_kharif_cropped_area_in_ha) < 140"
    },
    "sig_04": {
     "expr": "((soge.class_name != 'Safe') if is_text(soge.class_name) else nan) and mean(drought.dry_spell) > 6",
     "sheet": "soge_class_name != Safe AND mean(drysp_unit_4_weeks_)>6"
    },
    "sig_05": {
     "expr": "mean(drought.kharif_cropped_area) < 85",
     "sheet": "mean(kharif_cropped_area_percent_) < 85"
    }
   },
   "trigger": "(sig_01 + sig_02 + sig_03) * (sig_04 + sig_05) > 0",
   "sheet_trigger": "(sig_01 or sig_02 or sig_03) AND (sig_04 or sig_05)",
   "intensity": "(sig_01 + sig_02 + sig_03) * (sig_04 + sig_05)",
   "out_of": 6,
   "type": "stress"
  },
  {
   "id": "siltation",
   "section": "Agriculture / Water -> Waterbodies",
   "signals": {
    "sig_01": {
     "expr": "mean(div(swb.rabi_area, swb.kharif_area)) < 0.95",
     "sheet": "mean(rabi_area_in_ha_ / kharif_area_in_ha_) < 95%"
    },
    "sig_02": {
     "expr": "slope(swb.total_area) < 0",
     "sheet": "sen's slope(total_area_in_ha_) < 0"
    }
   },
   "trigger": "sig_01 + sig_02 > 0",
   "sheet_trigger": "sig_01 or sig_02",
   "intensity": "sig_01 + sig_02",
   "out_of": 2,
   "type": "stress"
  },
  {
   "id": "water_scarcity",
   "section": "Livelihood / Livestock",
   "signals": {
    "sig_01": {
     "expr": "mean(div(swb.rabi_area, swb.kharif_area)) < 0.3",
     "sheet": "mean(rabi_area_in_ha_ / kharif_area_in_ha_) < 30%"
    },
    "sig_02": {
     "expr": "slope(swb.total_area) < 0.7",
     "sheet": "sen's slope(total_area_in_ha_) < 0.7"
    },
    "sig_03": {
     "expr": "vmax.livestock_units_sheet > 2500",
     "sheet": "max(village large_animals_total * 3 + small_animals_total) > 2500"
    },
    "sig_04": {
     "expr": "sum(nz(nrega.soil_and_water_conservation)) < 20",
     "sheet": "sum_nrega_annual[Soil and water conservation_count] < 20"
    },
    "sig_05": {
     "expr": "river.n == 0",
     "sheet": "river is None"
    }
   },
   "trigger": "sig_03 * (sig_01 + sig_02 * (sig_04 + sig_05)) > 0",
   "sheet_trigger": "sig_03 and (sig_01 or (sig_02 and (sig_04 or sig_05)))",
   "intensity": "(sig_03 * sig_01 + sig_03 * sig_02) * (sig_04 + sig_03) * (sig_02 * sig_05)",
   "out_of": 4,
   "note": "Sheet intensity read literally: '(sig_03 and sig_01) + (sig_03 and sig_02) and (sig_04 + sig_03) and (sig_02 and sig_05)'. It has no 'out of'; 4 is its largest value.",
   "type": "stress"
  },
  {
   "id": "fodder_risk",
   "section": "Livelihood / Livestock",
   "signals": {
    "sig_01": {
     "expr": "tig.tree_loss_in_tree_in_shrub_area_in_ha > 2",
     "sheet": "tree_loss_in_tree_in_shrub_area_in_ha > 2ha"
    },
    "sig_02": {
     "expr": "fringe.tree_deforestation_fringe_area_in_ha > 25 and fringe.tree_degradation_fringe_area_in_ha > 25",
     "sheet": "tree_deforestation_fringe_area_in_ha > 25ha and tree_degradation_fringe_area_in_ha > 25ha"
    },
    "sig_03": {
     "expr": "((ndvi.shrub_trend == 'Decreasing') if is_text(ndvi.shrub_trend) else nan)",
     "sheet": "shrub_slope [from ndvi sheet] < 0, read as shrub_trend == decreasing"
    },
    "sig_04": {
     "expr": "vmax.livestock_units_sheet > 2000",
     "sheet": "max(village large_animals_total * 3 + small_animals_total) > 2000"
    }
   },
   "trigger": "sig_04 * (sig_01 + sig_02 + sig_03) > 0",
   "sheet_trigger": "sig_04 and (sig_01 or sig_02 or sig_03)",
   "intensity": "sig_04 * sig_01 + sig_04 * sig_02 + sig_04 * sig_03",
   "out_of": 3,
   "type": "stress"
  },
  {
   "id": "good_water_potential",
   "section": "Livelihood / Fishery",
   "type": "opportunity",
   "signals": {
    "sig_01": {
     "expr": "mean(div(swb.rabi_area, swb.kharif_area)) >= 0.8",
     "sheet": "mean(rabi_area_in_ha_ / kharif_area_in_ha_) >= 80%"
    },
    "sig_02": {
     "expr": "slope(swb.total_area) >= 0.3",
     "sheet": "sen's slope(total_area_in_ha_) >= 0.3"
    },
    "sig_03": {
     "expr": "sum(nz(nrega.soil_and_water_conservation)) >= 20",
     "sheet": "sum_nrega_annual[Soil and water conservation_count] >= 20"
    },
    "sig_04": {
     "expr": "mean(ci.cropping_intensity) < 1",
     "sheet": "average(cropping_intensity_unit_less) < 1"
    },
    "sig_05": {
     "expr": "div(vtop.shg_hhd, vtop.total_hhd) > 0.5",
     "sheet": "total_hhd_mobilized_into_shg/total_hhd > 0.5 [largest village]"
    }
   },
   "trigger": "sig_01 * (sig_02 + sig_03 + sig_04 + sig_05) > 0",
   "sheet_trigger": "sig_01 and (sig_02 or sig_03 or sig_04 or sig_05)",
   "intensity": "sig_01 * (sig_02 + sig_03 + sig_04 + sig_05)",
   "out_of": 4
  },
  {
   "id": "transition_from_crops_to_agroforestry",
   "section": "Livelihood / Agroforestry",
   "type": "opportunity",
   "signals": {
    "sig_01": {
     "expr": "100 * div(degr.farm_to_scrub_land_area, degr.total_degradation_area) > 60",
     "sheet": "100*farm_to_scrub_land_area_in_ha / total_degradation_area_in_ha > 60%"
    },
    "sig_02": {
     "expr": "slope(ci.cropping_intensity) < 0",
     "sheet": "sen slope(cropping_intensity_unit_less) < 0"
    },
    "sig_03": {
     "expr": "sum(nz(nrega.plantations)) >= 5",
     "sheet": "sum nrega_count[Plantations_count_] >= 5"
    },
    "sig_04": {
     "expr": "div(vtop.shg_hhd, vtop.total_hhd) > 0.5",
     "sheet": "total_hhd_mobilized_into_shg/total_hhd > 0.5 [largest village]"
    },
    "sig_05": {
     "expr": "(vtop.fpo_text == 'FPO' or vtop.fpo_text == 'Both') and vtop.coop_km < 5",
     "sheet": "(availability_of_fpos_pacs in [\"FPO\", \"BOTH\"]) and (cooperative_cat_distance_in_km < 5km) [largest village]"
    }
   },
   "trigger": "sig_01 + sig_02 > 0",
   "sheet_trigger": "sig_01 or sig_02",
   "intensity": "(sig_01 + sig_02) * (1 + sig_03 + sig_04 + sig_05)",
   "out_of": 8
  },
  {
   "id": "forest_degradation",
   "section": "Forest Biodiversity / Forests",
   "signals": {
    "sig_01": {
     "expr": "100 * div(tcd.total_tree_cover_decrease_area, area) > 7 or 100 * div(degr.total_degradation_area, area) > 4",
     "sheet": "%total_deforestation_area_in_ha (over mws) > 7 OR % total_degradation_area_in_ha (over mws) > 4"
    },
    "sig_02": {
     "expr": "mean(lulc.tree_forest_area) > 320 and tci.total_tree_cover_increase_area < 0.7 * tcd.total_tree_cover_decrease_area",
     "sheet": "average(tree_forest_area_in_ha_) > 320ha AND total_afforestation_area_in_ha < total_deforestation_area_in_ha * 0.7"
    },
    "sig_03": {
     "expr": "100 * div(tcd.forest_to_farm_area, mean(lulc.tree_forest_area)) > 6 and mean(lulc.tree_forest_area) > 600",
     "sheet": "% forest_to_farm_area_in_ha (over average(tree_forest_area_in_ha_)) > 6 AND average(tree_forest_area_in_ha_) > 600"
    }
   },
   "trigger": "sig_01 + sig_02 + sig_03 > 0",
   "sheet_trigger": "sig_01 or sig_02 or sig_03",
   "intensity": "sig_01 + sig_02 + sig_03",
   "out_of": 3,
   "note": "total_degradation_area is read from change_detection_degradation (farmland degradation), as the column name in the sheet says.",
   "type": "stress"
  },
  {
   "id": "multi_sector_vulnerability",
   "section": "Socio-economic",
   "signals": {
    "sig_01": {
     "expr": "vtop.st_pct + vtop.sc_pct > 60",
     "sheet": "ST_percent + SC_percent > 60% [largest village]"
    },
    "sig_02": {
     "expr": "nrega_works < 50",
     "sheet": "sum(all nrega_annual columns) < 50"
    },
    "sig_03": {
     "expr": "vtop.bank_km > 5",
     "sheet": "bank_branch_distance_in_km > 5km [largest village]"
    },
    "sig_04": {
     "expr": "vtop.literacy < 55",
     "sheet": "literacy_rate_percent < 55% [largest village]"
    },
    "sig_05": {
     "expr": "div(vtop.shg_hhd, vtop.total_hhd) > 0.4",
     "sheet": "total_hhd_mobilized_into_shg/total_hhd > 0.4 [largest village]"
    }
   },
   "trigger": "sig_01 + sig_02 + sig_03 + sig_04 + sig_05 >= 3",
   "sheet_trigger": "sig_01 + sig_02 + sig_03 + sig_04 + sig_05 >= 3",
   "intensity": "sig_01 + sig_02 + sig_03 + sig_04 + sig_05",
   "out_of": 5,
   "type": "stress"
  },
  {
   "id": "water_security_safety_domestic_use",
   "section": "Socio-economic / Health",
   "signals": {
    "sig_01": {
     "expr": "mine.n >= 1",
     "sheet": "mining == 1"
    },
    "sig_02": {
     "expr": "((terrain.terrain_cluster_id != 1) if not is_text(terrain.terrain_cluster_id) else (terrain.terrain_cluster_id != '1')) and tcd.total_tree_cover_decrease_area > 20 and mean(ci.cropping_intensity) < 1.5",
     "sheet": "terrain_cluster_id != '1' and total_deforestation_area_in_ha > 20ha and average(cropping_intensity_unit_less_) < 1.5"
    },
    "sig_03": {
     "expr": "mean(div(swb.rabi_area, swb.kharif_area)) < 0.95",
     "sheet": "mean(rabi_area_in_ha_ / kharif_area_in_ha_) < 95%"
    },
    "sig_04": {
     "expr": "((soge.class_name != 'Safe') if is_text(soge.class_name) else nan) + (mean(hydro.delta_g) <= 0) * ((conn.n_upstream == 0) + ((aquifer.aquifer_class == 'Hard Rock' or aquifer.aquifer_class == 'Hard rock') if is_text(aquifer.aquifer_class) else nan)) > 0",
     "sheet": "soge_class_name (of latest year) not in ['Safe'] or mean(DeltaG_in_mm_) <= 0mm and ((len(upstream_mws) == 0 or aquifer_class == 'Hard rock'))"
    },
    "sig_05": {
     "expr": "slope(swb.total_area) < 0.5 and sum(nz(nrega.soil_and_water_conservation)) < 10",
     "sheet": "sen's slope(total_area_in_ha_) < 0.5 and sum_nrega_annual[Soil and water conservation_count] < 10"
    }
   },
   "trigger": "sig_01 + sig_03 * (sig_02 + sig_04 + sig_05) > 0",
   "sheet_trigger": "sig_01 or (sig_03 and (sig_02 or sig_04 or sig_05))",
   "intensity": "sig_01 + sig_03 * (sig_02 + sig_04 + sig_05)",
   "out_of": 4,
   "note": "sig_04 has no brackets around or/and in the sheet; read as arithmetic it is soge_not_safe + (DeltaG <= 0) * (headwater + hard rock).",
   "type": "stress"
  }
 ]
}
